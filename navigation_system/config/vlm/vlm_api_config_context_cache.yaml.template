# ======================================================
# SpaceVLN explicit-context-cache API 配置模板
# ======================================================
#
# 使用方法：
#   1. 复制此文件为 navigation_system/config/vlm/vlm_api_config_context_cache.yaml
#   2. 填入你自己的 provider / key
#   3. 当前显式缓存实现已验证的后端是 DashScope Qwen：
#      - python vlm_navigation.py --runtime context_cache ...
#      - bash run_r2r/vlm_navigation.sh --runtime context_cache ...
#
# 说明：
#   - 外层入口统一为单一 `vlm_navigation.py` / `run_r2r/vlm_navigation.sh`；
#   - 底层缓存实现目前仍要求 DashScope + 支持 explicit cache 的 Qwen 模型。
#
# ======================================================

provider: "dashscope"

dashscope:
  api_key: "env:DASHSCOPE_API_KEY"
  base_url: "https://dashscope.aliyuncs.com/compatible-mode/v1"
  wire_api: "chat_completions"
  llm_model: "qwen3.5-plus"
  vlm_model: "qwen3.5-flash"

temperature: 0.1

llm_max_tokens: 4096
llm_timeout: 120

vlm_max_tokens: 300
vlm_timeout: 30

qwen_context_cache:
  enabled: true
  cache_type: "ephemeral"
  print_usage: true
  results_dir_suffix: "_cache"
