# ======================================================
# SpaceVLN 统一 API 配置
# ======================================================
#
# 使用方法：
#   1. 复制此文件为 navigation_system/config/api/vlm_api_config.yaml
#   2. 修改下方 provider 字段选择服务商
#   3. 填入对应服务商的 api_key
#
# ======================================================

# ── 切换服务商（只改这一行）────────────────────────────
#   "dashscope"  → 阿里云直连（国内推荐，低延迟，高TPS，~90-100 TPS）
#   "openrouter" → OpenRouter 海外节点（已固定走阿里云后端）
#   "openai"     → OpenAI 兼容 Responses API（GPT-5.4 / GPT-5.4-nano，thinking 关闭）
provider: "dashscope"


# ======================================================
# 方案1: 阿里 DashScope 直连（推荐）
# 申请地址: https://dashscope.console.aliyun.com/
# ======================================================
dashscope:
  api_key:  "sk-your-dashscope-key"
  base_url: "https://dashscope.aliyuncs.com/compatible-mode/v1"
  wire_api: "chat_completions"
  # 标准推荐：qwen3.5-plus 规划，qwen3.5-flash 动作
  # 显式缓存运行时也复用这两类模型
  llm_model: "qwen3.5-plus"
  vlm_model: "qwen3.5-flash"


# ======================================================
# 方案2: OpenRouter（海外节点，已固定路由 Alibaba 后端）
# 申请地址: https://openrouter.ai/
# ======================================================
openrouter:
  api_key:  "sk-or-your-openrouter-key"
  base_url: "https://openrouter.ai/api/v1"
  llm_model: "qwen3.5-plus"
  vlm_model: "qwen3.5-flash"


# ======================================================
# 方案3: OpenAI 兼容接口（Responses API）
# 说明:
#   - 支持 GPT-5.4 规划 + GPT-5.4-nano 动作
#   - 默认关闭 thinking：reasoning_effort = none
#   - 推荐把 key 放到环境变量 OPENAI_API_KEY 中
# ======================================================
openai:
  api_key: "env:OPENAI_API_KEY"
  base_url: "https://your-openai-compatible-endpoint"
  wire_api: "responses"
  llm_model: "gpt-5.4"
  vlm_model: "gpt-5.4-nano"
  reasoning_effort: "none"


# ======================================================
# 通用参数（一般不需要修改）
# ======================================================
temperature: 0.1

# LLM 规划器参数
llm_max_tokens: 4096    # 规划需要充足输出空间（6段 reasoning）
llm_timeout:    120     # 大模型首 token 慢，给足等待时间

# VLM 执行器参数
vlm_max_tokens: 300     # 动作输出极短，300 足够
vlm_timeout:    30      # Action 需要快速响应


# ======================================================
# 可选: Qwen 显式上下文缓存
# 仅对 `vlm_navigation_qwen_cache.py` / `run_r2r/vlm_navigation_qwen_cache.sh` 生效
# ======================================================
qwen_context_cache:
  enabled: false
  cache_type: "ephemeral"
  print_usage: false
  results_dir_suffix: "_cache"
