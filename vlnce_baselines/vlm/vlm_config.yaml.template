# VLM Configuration Template
# VLM配置模板 - 用于低层动作执行（看Detection图→输出动作）
# 
# 使用方法：
# 1. 复制此文件为 vlm_config.yaml
# 2. 填入你的API密钥和模型信息
#
# 💡 VLM只需处理1张Detection图，可以用较小/快速的模型
# 💡 VLM和LLM可以用同一个API key，只换模型名

# ========================
# 方案1: 阿里DashScope直连（推荐 - 国内最快最便宜）
# ========================
api_key: "sk-your-dashscope-api-key"
base_url: "https://dashscope.aliyuncs.com/compatible-mode/v1"
# Qwen-VL 视觉模型（Action需要看图）:
#   qwen-vl-plus-latest    - 快+便宜 $0.56/M input (推荐Action用)
#   qwen-vl-plus           - 快+便宜，稳定版
#   qwen-vl-max-latest     - 最强（和LLM用同一个也行）
model: "qwen-vl-plus-latest"

# ========================
# 方案2: OpenRouter
# ========================
# ⚠️ 注意：OpenRouter会随机路由到不同后端，速度差异大（30~100 TPS）
# 程序已自动在 payload 中加入 "order":["Alibaba"] 固定优先走阿里云后端
# api_key: "sk-or-your-openrouter-key"
# base_url: "https://openrouter.ai/api/v1"
# Qwen3 VL 系列（2025年最新）:
#   qwen/qwen3-vl-8b-instruct       - 快（8B，Action执行推荐）
#   qwen/qwen3-vl-30b-a3b-instruct  - 强（MoE 30B/A3B，备选）
# model: "qwen/qwen3-vl-8b-instruct"

# ========================
# 方案3: OpenAI
# ========================
# api_key: "sk-your-openai-key"
# base_url: "https://api.openai.com/v1"
# model: "gpt-4o-mini"

# 通用参数
temperature: 0.1
max_tokens: 300       # Action输出很短，300足够
timeout: 30           # Action需要快速响应
