# LLM Configuration Template
# LLM配置模板 - 用于高层规划（分析12方向图像+地图→生成子任务）
# 
# 使用方法：
# 1. 复制此文件为 llm_config.yaml
# 2. 填入你的API密钥和模型信息
#
# ⚠️ LLM需要视觉模型（接收12张方向图+地图）

# ========================
# 方案1: 阿里DashScope直连（推荐 - 国内最快最便宜）
# ========================
# 申请地址: https://dashscope.console.aliyun.com/
api_key: "sk-your-dashscope-api-key"
base_url: "https://dashscope.aliyuncs.com/compatible-mode/v1"
# Qwen-VL 视觉模型（LLM规划必须用视觉模型）:
#   qwen-vl-max-latest     - 最强，$2.8/M input (推荐)
#   qwen-vl-max            - 强，稳定版
#   qwen-vl-plus-latest    - 快+便宜，$0.56/M input
#   qwen-vl-plus           - 快+便宜，稳定版
model: "qwen-vl-max-latest"

# ========================
# 方案2: OpenRouter（海外节点，模型选择多）
# ========================
# api_key: "sk-or-your-openrouter-key"
# base_url: "https://openrouter.ai/api/v1"
# model: "qwen/qwen-2.5-vl-72b-instruct"

# ========================
# 方案3: OpenAI
# ========================
# api_key: "sk-your-openai-key"
# base_url: "https://api.openai.com/v1"
# model: "gpt-4o"

# 通用参数
temperature: 0.1
max_tokens: 4096      # LLM规划需要充足输出空间（6部分reasoning）
timeout: 120          # DashScope大模型可能需要较长时间
