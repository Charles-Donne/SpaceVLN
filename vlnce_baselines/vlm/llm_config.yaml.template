# LLM Configuration Template
# LLM配置模板 - 用于高层规划
# 
# 使用方法：
# 1. 复制此文件为 llm_config.yaml
# 2. 填入你的API密钥和模型信息

# API密钥（必填）
api_key: "your-openrouter-api-key-here"

# API基础URL（必填）
# OpenRouter: https://openrouter.ai/api/v1
# OpenAI: https://api.openai.com/v1
base_url: "https://openrouter.ai/api/v1"

# 模型名称（必填）
# OpenRouter Qwen3 (推荐 - 快速+便宜+支持视觉):
#   qwen/qwen-2.5-vl-72b-instruct    - 最强视觉理解
#   qwen/qwen3-235b-a22b              - 最强推理
#   qwen/qwen3-32b                    - 性价比最高
# OpenAI: gpt-4o, gpt-4o-mini
# Claude: anthropic/claude-3.5-sonnet
model: "qwen/qwen3-235b-a22b"

# 温度参数（可选，默认0.1）
temperature: 0.1

# 最大输出token数（可选）
# LLM规划需要充足的输出空间（分析6部分reasoning）
max_tokens: 4096

# API超时时间（可选，默认60秒）
# Qwen3响应较快，可以设短一点
timeout: 120
