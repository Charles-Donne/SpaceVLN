# ======================================================
# SpaceVLN 统一 API 配置
# ======================================================
#
# 使用方法：
#   1. 复制此文件为 api_config.yaml
#   2. 修改下方 provider 字段选择服务商
#   3. 填入对应服务商的 api_key
#
# ======================================================

# ── 切换服务商（只改这一行）────────────────────────────
#   "dashscope"  → 阿里云直连（国内推荐，低延迟，高TPS，~90-100 TPS）
#   "openrouter" → OpenRouter 海外节点（已固定走阿里云后端）
provider: "dashscope"


# ======================================================
# 方案1: 阿里 DashScope 直连（推荐）
# 申请地址: https://dashscope.console.aliyun.com/
# ======================================================
dashscope:
  api_key:  "sk-your-dashscope-key"
  base_url: "https://dashscope.aliyuncs.com/compatible-mode/v1"
  # LLM 规划模型（高层：分析12张方向图 + 地图 → 生成子任务）
  #   qwen-vl-max-latest     最强视觉推理，$2.8/M input（推荐规划）
  #   qwen-vl-max            稳定版
  #   qwen-vl-plus-latest    快+便宜，$0.56/M input
  llm_model: "qwen-vl-max-latest"
  # VLM 执行模型（低层：看 Detection 图 → 输出动作）
  #   qwen-vl-plus-latest    快+便宜（推荐 Action 执行）
  #   qwen-vl-max-latest     更强（和 LLM 同款也可以）
  vlm_model: "qwen-vl-plus-latest"


# ======================================================
# 方案2: OpenRouter（海外节点，已固定路由 Alibaba 后端）
# 申请地址: https://openrouter.ai/
# ======================================================
openrouter:
  api_key:  "sk-or-your-openrouter-key"
  base_url: "https://openrouter.ai/api/v1"
  # Qwen3 VL 系列（2025 最新）
  #   qwen/qwen3-vl-30b-a3b-instruct   强（MoE 30B/A3B，推荐规划）
  #   qwen/qwen3-vl-8b-instruct         快（8B，推荐执行）
  #   qwen/qwen2.5-vl-72b-instruct      旧款强模型（稳定）
  llm_model: "qwen/qwen3-vl-30b-a3b-instruct"
  vlm_model: "qwen/qwen3-vl-8b-instruct"


# ======================================================
# 通用参数（一般不需要修改）
# ======================================================
temperature: 0.1

# LLM 规划器参数
llm_max_tokens: 4096    # 规划需要充足输出空间（6段 reasoning）
llm_timeout:    120     # 大模型首 token 慢，给足等待时间

# VLM 执行器参数
vlm_max_tokens: 300     # 动作输出极短，300 足够
vlm_timeout:    30      # Action 需要快速响应
